# Copy to .env (never commit it). Generate each secret once and keep it.
POSTGRES_PASSWORD=
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
ENCRYPTION_KEY=
# openssl rand -hex 32
ADCP_SIGNING_KEK=
FLASK_SECRET_KEY=

# Public URL the agent answers at; first boot creates the default tenant for its host
ADCP_AGENT_URL=https://salesagent.ngrok.dev
CREATE_DEMO_TENANT=true
# Test deployment: publishers verify without an adagents.json check (else products show "Not offered to buyers")
PUBLISHER_AUTO_VERIFY=true

# ngrok agent authtoken owning salesagent.ngrok.dev (vault: ngrok/authtoken)
NGROK_AUTHTOKEN=

# Admin login: Google OAuth client with redirect URI https://<public host>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Required in production: the tenant login sends no redirect_uri without it
GOOGLE_OAUTH_REDIRECT_URI=https://salesagent.ngrok.dev/auth/google/callback
SUPER_ADMIN_EMAILS=

# GAM OAuth (optional; a GAM service account can be set per tenant in the Admin UI instead)
GAM_OAUTH_CLIENT_ID=
GAM_OAUTH_CLIENT_SECRET=
